.git
.github
.claude
__pycache__/
*.pyc
.ipynb_checkpoints/
**/data_cache/
tools/

# The host's virtualenv. Absent from this list until August 2026, it was copied
# into every published image: 670 MB of Linux-host Python that the container
# never used, since it runs /opt/conda.
.venv/

# Instructor-only material, matching .gitignore. It is not in the repository, so
# it cannot normally be here — but a build from a working copy that has it must
# not carry it into an image students pull.
Instructor/
Solutions/

# Also instructor-only and git-ignored, and present in a working copy: the study
# sessions and private notes of each lesson, and the instructor's notes file.
# tools/release.py builds from `git archive` of HEAD, which cannot contain them;
# these lines protect a build from a working copy, such as compose.dev.yml.
Lessons/*/Review/
notes.txt
